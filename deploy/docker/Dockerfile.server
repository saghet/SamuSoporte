FROM rust:1.80-alpine AS builder

RUN apk add --no-cache musl-dev perl make

WORKDIR /usr/src/opensupport
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY apps/ apps/

RUN cargo build --release --bin opensupport-server

FROM alpine:3.20

RUN apk add --no-cache ca-certificates

WORKDIR /app
COPY --from=builder /usr/src/opensupport/target/release/opensupport-server /app/opensupport-server

EXPOSE 8080

ENTRYPOINT ["/app/opensupport-server"]
