<ui:FluentWindow x:Class="OpenSupport.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        xmlns:uim="clr-namespace:Wpf.Ui.Markup;assembly=Wpf.Ui"
        mc:Ignorable="d"
        Title="SamuSoporte - Asistencia Remota Nativa" 
        Height="760" Width="1160"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Icon="AppIcon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Fluent -->
        <ui:TitleBar
            Grid.Row="0"
            Title="SamuSoporte • E2EE Zero Trust Native"
            Height="42" />

        <!-- Layout con Barra Lateral y Contenedor de Vistas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Barra Lateral Nativa Fluent -->
            <Border Grid.Column="0" Background="#0b1329" BorderBrush="#1e293b" BorderThickness="0,0,1,0" Padding="12,16">
                <DockPanel>
                    <!-- Menú Inferior: Configuración -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <ui:Button x:Name="NavConfiguracion" Icon="{uim:SymbolIcon Symbol=Settings24}" Content="Configuración" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,2"
                                   Click="NavButton_Click" Tag="Configuracion" />
                    </StackPanel>

                    <!-- Lista de Navegación Principal -->
                    <StackPanel>
                        <ui:Button x:Name="NavPanelPrincipal" Icon="{uim:SymbolIcon Symbol=Home24}" Content="Panel Principal" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Primary" Margin="0,3"
                                   Click="NavButton_Click" Tag="PanelPrincipal" />
                        <ui:Button x:Name="NavSoporteRemoto" Icon="{uim:SymbolIcon Symbol=Desktop24}" Content="Soporte Remoto" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,3"
                                   Click="NavButton_Click" Tag="SoporteRemoto" />
                        <ui:Button x:Name="NavMisDispositivos" Icon="{uim:SymbolIcon Symbol=Laptop24}" Content="Mis Dispositivos" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,3"
                                   Click="NavButton_Click" Tag="MisDispositivos" />
                        <ui:Button x:Name="NavConsolaTecnico" Icon="{uim:SymbolIcon Symbol=Wrench24}" Content="Consola Técnico" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,3"
                                   Click="NavButton_Click" Tag="ConsolaTecnico" />
                        <ui:Button x:Name="NavSeguridadZeroTrust" Icon="{uim:SymbolIcon Symbol=Shield24}" Content="Seguridad &amp; Zero Trust" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,3"
                                   Click="NavButton_Click" Tag="SeguridadZeroTrust" />
                        <ui:Button x:Name="NavAuditoriaInmutable" Icon="{uim:SymbolIcon Symbol=DocumentBulletList24}" Content="Auditoría Inmutable" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Margin="0,3"
                                   Click="NavButton_Click" Tag="AuditoriaInmutable" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Contenedor Dinámico de Vistas -->
            <Grid Grid.Column="1">

                <!-- 1. VISTA: PANEL PRINCIPAL -->
                <ScrollViewer x:Name="ViewPanelPrincipal" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32" MaxWidth="960" HorizontalAlignment="Left">
                        <TextBlock Text="Panel Principal de Asistencia" FontSize="26" FontWeight="Bold" Foreground="#f8fafc" />
                        <TextBlock Text="Control remoto asistido y supervisado con cifrado Noise Protocol E2EE y arquitectura Zero Trust." Margin="0,4,0,20" Foreground="#94a3b8" />

                        <!-- Alerta de Conexión Relay -->
                        <ui:InfoBar
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Success"
                            Title="Servidor de Relay Conectado"
                            Message="Túnel Zero-Knowledge listo. El servidor de tránsito no posee capacidad de inspección de datos."
                            Margin="0,0,0,20" />

                        <!-- Banner de Sesión Activa -->
                        <Border x:Name="ActiveSessionCard" Visibility="Collapsed" Background="#3b0764" BorderBrush="#a855f7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Warning24" FontSize="28" Foreground="#e879f9" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="SESIÓN REMOTA ACTIVA SUPERVISADA" FontWeight="Bold" Foreground="#f5d0fe" />
                                    <TextBlock x:Name="ActiveSessionText" Text="Un operador autorizado tiene control de este equipo." Foreground="#e9d5ff" />
                                    <TextBlock x:Name="SasCodeText" Text="SAS Anti-MitM: 482 910" FontWeight="SemiBold" Foreground="#38bdf8" Margin="0,4,0,0" />
                                </StackPanel>
                                <ui:Button x:Name="EmergencyStopBtn" Grid.Column="2" Appearance="Danger" Content="DETENER SESIÓN INMEDIATAMENTE" Click="EmergencyStopBtn_Click" />
                            </Grid>
                        </Border>

                        <!-- Tarjetas Principales -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Permitir Control Asistido -->
                            <Border Grid.Column="0" Background="#0f172a" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Permitir Control Asistido" FontSize="18" FontWeight="SemiBold" Foreground="#38bdf8" />
                                    <TextBlock Text="Comparte este código temporal con tu técnico autorizado para otorgarle acceso supervisado." Margin="0,6,0,16" TextWrapping="Wrap" Foreground="#94a3b8" />

                                    <Border Background="#020617" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TempCodeBlock" Text="582 914" FontSize="34" FontFamily="Consolas" FontWeight="Bold" Foreground="#4ade80" VerticalAlignment="Center" />
                                            <ui:Button x:Name="CopyCodeBtn" Grid.Column="1" Icon="{uim:SymbolIcon Symbol=Copy24}" Click="CopyCodeBtn_Click" ToolTip="Copiar Código" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button x:Name="RegenCodeBtn" Content="Regenerar Código" Click="RegenCodeBtn_Click" />
                                        <TextBlock Text="Caduca en 15 min" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#64748b" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Conectar a Equipo Remoto -->
                            <Border Grid.Column="2" Background="#0f172a" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Conectar a un Equipo Remoto" FontSize="18" FontWeight="SemiBold" Foreground="#38bdf8" />
                                    <TextBlock Text="Introduce el código de soporte de 6 dígitos o Device ID del equipo al que brindarás asistencia." Margin="0,6,0,16" TextWrapping="Wrap" Foreground="#94a3b8" />

                                    <ui:TextBox x:Name="TargetInput" PlaceholderText="Ej: 582 914 o DeviceID..." FontSize="16" Margin="0,0,0,16" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button x:Name="ConnectBtn" Grid.Column="0" Appearance="Primary" Content="Iniciar Asistencia Remota" Click="ConnectBtn_Click" HorizontalAlignment="Stretch" />
                                        <ui:Button x:Name="FileTransferBtn" Grid.Column="2" Content="Sólo Archivos" Click="FileTransferBtn_Click" />
                                    </Grid>

                                    <TextBlock x:Name="StatusLabel" Margin="0,10,0,0" Foreground="#38bdf8" FontSize="13" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Historial de Conexiones Recientes -->
                        <Border Background="#0f172a" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Historial de Conexiones Recientes" FontSize="16" FontWeight="SemiBold" Foreground="#f8fafc" Margin="0,0,0,12" />
                                <Border Background="#020617" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DESKTOP-FINANZAS-01 (Windows 11 Pro)" VerticalAlignment="Center" Foreground="#cbd5e1" />
                                        <TextBlock Grid.Column="1" Text="Hace 2 horas" VerticalAlignment="Center" Foreground="#64748b" />
                                        <ui:Button Grid.Column="2" Content="Reconectar" HorizontalAlignment="Right" Click="QuickConnect_Click" Tag="DESKTOP-FINANZAS-01" />
                                    </Grid>
                                </Border>
                                <Border Background="#020617" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="SRV-DATABASE-02 (Windows Server 2022)" VerticalAlignment="Center" Foreground="#cbd5e1" />
                                        <TextBlock Grid.Column="1" Text="Ayer, 16:45" VerticalAlignment="Center" Foreground="#64748b" />
                                        <ui:Button Grid.Column="2" Content="Reconectar" HorizontalAlignment="Right" Click="QuickConnect_Click" Tag="SRV-DATABASE-02" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. VISTA: SOPORTE REMOTO (VISOR EN VIVO) -->
                <ScrollViewer x:Name="ViewSoporteRemoto" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32" MaxWidth="1000" HorizontalAlignment="Left">
                        <TextBlock Text="Soporte y Control Remoto Nativo" FontSize="26" FontWeight="Bold" Foreground="#f8fafc" />
                        <TextBlock Text="Visualizador de streaming de pantalla de baja latencia con aceleración DirectX y Desktop Duplication." Margin="0,4,0,20" Foreground="#94a3b8" />

                        <!-- Barra de Herramientas de Sesión Remota -->
                        <Border Background="#0f172a" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <ui:Button Icon="{uim:SymbolIcon Symbol=Tv24}" Content="Monitor 1 (1080p)" Margin="0,0,8,0" Appearance="Primary" />
                                    <ui:Button Icon="{uim:SymbolIcon Symbol=Tv24}" Content="Monitor 2 (4K)" Margin="0,0,8,0" />
                                    <ui:Button Icon="{uim:SymbolIcon Symbol=Clipboard24}" Content="Sincronizar Portapapeles" Margin="0,0,8,0" Click="ActionFeedback_Click" Tag="Portapapeles bidireccional activado con filtrado seguro." />
                                    <ui:Button Icon="{uim:SymbolIcon Symbol=FolderArrowRight24}" Content="Enviar Archivo" Margin="0,0,8,0" Click="ActionFeedback_Click" Tag="Iniciando canal de transferencia SHA-256 seguro." />
                                    <ui:Button Icon="{uim:SymbolIcon Symbol=Keyboard24}" Content="Ctrl+Alt+Del" Click="ActionFeedback_Click" Tag="Enviando señal de seguridad SAS a través del Servicio de Windows." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Border Background="#1e293b" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock Text="Latencia: 14 ms" Foreground="#4ade80" FontWeight="SemiBold" FontSize="12" />
                                    </Border>
                                    <Border Background="#1e293b" CornerRadius="4" Padding="8,4">
                                        <TextBlock Text="Bitrate: 3.2 Mbps" Foreground="#38bdf8" FontWeight="SemiBold" FontSize="12" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Visor de Pantalla Simulada -->
                        <Border Background="#020617" BorderBrush="#334155" BorderThickness="2" CornerRadius="8" Height="420" Margin="0,0,0,16">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="64" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                    <TextBlock Text="Visualizador de Sesión de Escritorio Remoto" FontSize="18" FontWeight="SemiBold" Foreground="#cbd5e1" HorizontalAlignment="Center" />
                                    <TextBlock Text="Túnel cifrado con ChaCha20-Poly1305. Esperando conexión o equipo remoto seleccionado." Foreground="#64748b" HorizontalAlignment="Center" Margin="0,6,0,16" />
                                    <ui:Button Appearance="Primary" Content="Iniciar Transmisión de Prueba Local" HorizontalAlignment="Center" Click="ActionFeedback_Click" Tag="Visualizador listo con Desktop Duplication API y hardware encoder." />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. VISTA: MIS DISPOSITIVOS -->
                <ScrollViewer x:Name="ViewMisDispositivos" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32" MaxWidth="960" HorizontalAlignment="Left">
                        <TextBlock Text="Dispositivos Administrados" FontSize="26" FontWeight="Bold" Foreground="#f8fafc" />
                        <TextBlock Text="Equipos autorizados con agente desatendido y credenciales criptográficas registradas." Margin="0,4,0,20" Foreground="#94a3b8" />

                        <!-- Tabla de Dispositivos -->
                        <Border Background="#0f172a" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="NOMBRE DEL EQUIPO" FontWeight="Bold" Foreground="#64748b" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="ESTADO" FontWeight="Bold" Foreground="#64748b" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="SISTEMA OPERATIVO" FontWeight="Bold" Foreground="#64748b" FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="GRUPO" FontWeight="Bold" Foreground="#64748b" FontSize="12" />
                                    <TextBlock Grid.Column="4" Text="ACCIÓN" FontWeight="Bold" Foreground="#64748b" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>

                                <Separator Background="#1e293b" Margin="0,0,0,12" />

                                <!-- Fila 1 -->
                                <Border Background="#020617" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DESKTOP-FINANZAS-01" Foreground="#f8fafc" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="● En línea" Foreground="#4ade80" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="Windows 11 Pro 24H2" Foreground="#94a3b8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="Contabilidad" Foreground="#cbd5e1" VerticalAlignment="Center" />
                                        <ui:Button Grid.Column="4" Appearance="Primary" Content="Conectar" HorizontalAlignment="Right" Click="QuickConnect_Click" Tag="DESKTOP-FINANZAS-01" />
                                    </Grid>
                                </Border>

                                <!-- Fila 2 -->
                                <Border Background="#020617" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="SRV-DATABASE-02" Foreground="#f8fafc" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="● En línea" Foreground="#4ade80" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="Windows Server 2022" Foreground="#94a3b8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="Infraestructura" Foreground="#cbd5e1" VerticalAlignment="Center" />
                                        <ui:Button Grid.Column="4" Appearance="Primary" Content="Conectar" HorizontalAlignment="Right" Click="QuickConnect_Click" Tag="SRV-DATABASE-02" />
                                    </Grid>
                                </Border>

                                <!-- Fila 3 -->
                                <Border Background="#020617" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="LAPTOP-DEV-SAMU" Foreground="#f8fafc" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="○ Desconectado" Foreground="#64748b" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="Windows 11 Enterprise" Foreground="#94a3b8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="Desarrollo" Foreground="#cbd5e1" VerticalAlignment="Center" />
                                        <ui:Button Grid.Column="4" Content="Despertar (WoL)" HorizontalAlignment="Right" Click="ActionFeedback_Click" Tag="Enviando paquete Magic Packet Wake-on-LAN." />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. VISTA: CONSOLA DEL TÉCNICO -->
                <ScrollViewer x:Name="ViewConsolaTecnico" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32" MaxWidth="960" HorizontalAlignment="Left">
                        <TextBlock Text="Consola del Técnico &amp; Diagnósticos" FontSize="26" FontWeight="Bold" Foreground="#f8fafc" />
                        <TextBlock Text="Monitoreo en vivo de hardware, procesos remotos, servicios Windows y ejecución supervisada." Margin="0,4,0,20" Foreground="#94a3b8" />

                        <!-- Diagnósticos Rápidos de Hardware -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0f172a" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="USO DE CPU" FontSize="12" FontWeight="Bold" Foreground="#64748b" />
                                    <TextBlock Text="18.4 %" FontSize="26" FontWeight="Bold" Foreground="#38bdf8" Margin="0,6,0,0" />
                                    <TextBlock Text="Intel Core i9-13900K" FontSize="11" Foreground="#94a3b8" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#0f172a" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="MEMORIA RAM" FontSize="12" FontWeight="Bold" Foreground="#64748b" />
                                    <TextBlock Text="9.8 / 32 GB" FontSize="26" FontWeight="Bold" Foreground="#4ade80" Margin="0,6,0,0" />
                                    <TextBlock Text="31% en uso (Estable)" FontSize="11" Foreground="#94a3b8" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="#0f172a" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="ALMACENAMIENTO C:" FontSize="12" FontWeight="Bold" Foreground="#64748b" />
                                    <TextBlock Text="398 GB Libres" FontSize="26" FontWeight="Bold" Foreground="#a855f7" Margin="0,6,0,0" />
                                    <TextBlock Text="NVMe SSD PCIe 4.0" FontSize="11" Foreground="#94a3b8" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Herramientas Administrativas -->
                        <Border Background="#0f172a" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Herramientas del Sistema Remoto" FontSize="16" FontWeight="SemiBold" Foreground="#f8fafc" Margin="0,0,0,16" />
                                <WrapPanel>
                                    <ui:Button Icon="{uim:SymbolIcon Symbol=DeveloperBoard24}" Content="Administrador de Tareas" Margin="0,0,10,10" Click="ActionFeedback_Click" Tag="Consultando lista de procesos a través del motor Rust." />
                                    <ui:Button Icon="{uim:SymbolIcon Symbol=Server24}" Content="Servicios Windows" Margin="0,0,10,10" Click="ActionFeedback_Click" Tag="Recuperando estado de servicios locales autorizados." />
                                    <ui:Button Icon="{uim:SymbolIcon Symbol=WindowDevTools24}" Content="Visor de Sucesos (EventLog)" Margin="0,0,10,10" Click="ActionFeedback_Click" Tag="Filtrando eventos de advertencia y error del sistema." />
                                    <ui:Button Icon="{uim:SymbolIcon Symbol=ArrowDownload24}" Content="Actualizaciones de Windows" Margin="0,0,10,10" Click="ActionFeedback_Click" Tag="Verificando estado de parches KB y actualizaciones." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 5. VISTA: SEGURIDAD & ZERO TRUST -->
                <ScrollViewer x:Name="ViewSeguridadZeroTrust" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32" MaxWidth="960" HorizontalAlignment="Left">
                        <TextBlock Text="Centro de Seguridad &amp; Arquitectura Zero Trust" FontSize="26" FontWeight="Bold" Foreground="#f8fafc" />
                        <TextBlock Text="Criptografía de extremo a extremo, protección contra suplantación (Anti-MitM) y control de privilegios." Margin="0,4,0,20" Foreground="#94a3b8" />

                        <!-- Estado Criptográfico -->
                        <Border Background="#0f172a" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Criptografía y Llaves del Dispositivo" FontSize="16" FontWeight="SemiBold" Foreground="#38bdf8" Margin="0,0,0,12" />
                                
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Protocolo de Túnel E2EE:" Foreground="#94a3b8" />
                                    <TextBlock Grid.Column="1" Text="Noise Protocol Framework (Noise_XX_25519_ChaChaPoly_BLAKE2s)" Foreground="#4ade80" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Llave Pública del Dispositivo:" Foreground="#94a3b8" />
                                    <TextBlock Grid.Column="1" Text="ed25519:7a4f91b2c3d4e5f6... (Firmada criptográficamente)" FontFamily="Consolas" Foreground="#cbd5e1" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
