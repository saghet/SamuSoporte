<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenSupport_App.Pages.TechnicianConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Caja de Herramientas y Diagnóstico del Técnico" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock Text="Inspección remota de hardware, telemetría de rendimiento y gestión de procesos del host." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Uso Global CPU" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="14.2%" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <ProgressBar Value="14.2" Maximum="100" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Memoria RAM en Uso" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="8.4 GB / 32.0 GB" FontSize="28" FontWeight="Bold" />
                        <ProgressBar Value="26.25" Maximum="100" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Almacenamiento (C:)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="482 GB Libres" FontSize="28" FontWeight="Bold" />
                        <ProgressBar Value="52" Maximum="100" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Administrador de Procesos Remoto -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Procesos en Ejecución" FontWeight="SemiBold" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Terminar Proceso Seleccionado" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </Grid>

                    <ListView SelectionMode="Single">
                        <ListViewItem>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PID: 1248" FontFamily="Consolas" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="explorer.exe" FontWeight="Medium" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="CPU: 0.8%" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="RAM: 142 MB" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PID: 5892" FontFamily="Consolas" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="OpenSupport.Service.exe" FontWeight="Medium" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="CPU: 0.1%" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="RAM: 34 MB" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
