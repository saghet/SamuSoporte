<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenSupport_App.Pages.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Seguridad y Arquitectura Zero Trust" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock Text="Parámetros de cifrado de extremo a extremo, identidades Ed25519 y políticas de acceso." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Identidad Criptográfica del Dispositivo" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Clave pública Ed25519 / Huella Digital SHA-256 única para este endpoint:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                        <TextBlock Text="ed25519:7e49f8a201b...99ca48e10bf234" FontFamily="Consolas" FontWeight="Medium" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>

                    <ToggleSwitch Header="Autenticación Multifactor (MFA) Obligatoria" IsOn="True" />
                    <ToggleSwitch Header="Verificación SAS (Short Authentication String) Visual en Conexión" IsOn="True" />
                    <ToggleSwitch Header="Permitir Acceso Desatendido (Requiere Contraseña Maestra y DPAPI)" IsOn="False" />
                    <ToggleSwitch Header="Bloquear Transferencia de Archivos Ejecutables (.exe, .dll, .bat)" IsOn="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
