<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenSupport_App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Left">
            <!-- Header Banner -->
            <StackPanel Spacing="6">
                <TextBlock Text="Panel Principal de Asistencia" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock Text="Control remoto asistido y administración bajo modelo Zero Trust con cifrado Noise Protocol E2EE." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Status InfoBar -->
            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Success"
                Title="Servicio de Relay Conectado"
                Message="Canal E2EE listo. Las conexiones remotas operan con secreto perfecto hacia adelante (PFS)." />

            <!-- Banner Activo de Sesión Remota (Requisito Obligatorio) -->
            <Border
                x:Name="ActiveSessionBanner"
                Visibility="Collapsed"
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SESIÓN REMOTA EN CURSO" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="ActiveTechText" Text="Un técnico autorizado está interactuando con este equipo." Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="SasCodeText" Text="SAS Anti-MitM: --- ---" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button
                        x:Name="EmergencyStopBtn"
                        Grid.Column="2"
                        Content="DETENER SESIÓN INMEDIATAMENTE"
                        Click="EmergencyStopBtn_Click"
                        Style="{ThemeResource AccentButtonStyle}"
                        Background="{ThemeResource SystemFillColorCriticalBrush}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Sección de Códigos y Conexión en Grid -->
            <Grid ColumnSpacing="20" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tarjeta: Mi Código de Soporte -->
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D7;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Permitir Control Asistido" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock Text="Comparte tu identificador y este código temporal de 6 dígitos con el técnico autorizado para permitirle acceso supervisado." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                        <Border
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TempCodeDisplay" Text="582 914" FontSize="32" FontFamily="Consolas" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <Button x:Name="CopyCodeBtn" Grid.Column="1" Click="CopyCodeBtn_Click" ToolTipService.ToolTip="Copiar Código">
                                    <FontIcon Glyph="&#xE8C8;" />
                                </Button>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RegenCodeBtn" Content="Regenerar Código" Click="RegenCodeBtn_Click" />
                            <TextBlock Text="Caduca en 15 min" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tarjeta: Conectar a Equipo Remoto -->
                <Border
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8AF;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Conectar a un Equipo Remoto" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock Text="Introduce el código de sesión o Device ID del equipo que deseas asistir o administrar." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                        <TextBox x:Name="TargetDeviceInput" PlaceholderText="Ej: 582 914 o SHA256-ID..." FontFamily="Consolas" FontSize="16" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ConnectBtn" Grid.Column="0" Content="Iniciar Asistencia Remota" Click="ConnectBtn_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                            <Button x:Name="FileTransferOnlyBtn" Grid.Column="1" Content="Sólo Archivos" Click="FileTransferOnlyBtn_Click" />
                        </Grid>

                        <TextBlock x:Name="ConnectionFeedback" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Equipos Recientes -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Conexiones Recientes y Dispositivos de Confianza" FontWeight="SemiBold" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ListView x:Name="RecentSessionsList" SelectionMode="None">
                        <!-- Poblado en código -->
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
